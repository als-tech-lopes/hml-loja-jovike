# Front-end public configuration. Never place the service_role key in VITE_* variables.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Configure this secret on the admin-users Edge Function, not in the front-end host.
# ALLOWED_ORIGINS=https://your-production-domain.example
